# WorkVista Environment Configuration
PROJECT_NAME="WorkVista"
PROJECT_VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (SQLite default, easily swappable for PostgreSQL)
DATABASE_URL="sqlite:///./data/workvista.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/workvista"

# Model Training Defaults
DEFAULT_HIGH_PERF_THRESHOLD=80.0
DEFAULT_MEDIUM_PERF_THRESHOLD=50.0
DEFAULT_RISK_THRESHOLD=50.0
DEFAULT_MODEL_TYPE="RandomForest"
DEFAULT_TEST_SIZE=0.2
RANDOM_STATE=42
